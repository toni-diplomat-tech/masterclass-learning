# The VPS's .env (in the repo checkout on the server, git-ignored). deploy/wizard.sh writes it for you.
# Runs the production override on every plain `docker compose` command.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# The Host's domain, pointed at the VPS by an A record. Caddy gets its certificate.
DOMAIN=quiz.example.com
# SQL Server SA password: at least 8 characters from 3 of upper, lower, digits, symbols.
MSSQL_SA_PASSWORD=ChangeMe_Str0ngPassword
# Hash of the Host's password, never the password itself (the wizard makes it; see README "Host password").
HOST_PASSWORD_HASH=pbkdf2-sha256.600000.<salt>.<key>
# Only for the wizard; docker compose ignores them.
SERVER_IP=203.0.113.10
DEPLOY_BRANCH=main
